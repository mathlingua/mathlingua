-- Items that relate definitions to each other or to documentation.


[\left.identity:in{M}]
Defines: e
when: M is \magma
Documented:
. called: "left identity in $M?$"
Id: "fadd40a3-bcdd-48e1-a884-3daa2350930d"


[\right.identity:in{M}]
Defines: e
when: M is \magma
Documented:
. called: "right identity in $M?$"
Id: "30e3180b-c8e2-4964-944b-693b83a682b8"


-- `Equivalent` declares several commands interchangeable under one name. The
-- `Equivalent:` section takes no argument; say why in `Documented:`.
[\identity:in{M}]
Equivalent:
when: M is \magma
to:
. \left.identity:in{M}
. \right.identity:in{M}
Documented:
. called: "identity in $M?$"
Id: "5d6aee8a-a36d-4873-8849-42a254e85305"


-- `Relation` records a relationship between two concepts, topics, or
-- definitions. Each side is a declaration or a quoted reference.
Relation:
between: G is \group
and: M is \magma
means: "Every group is a magma under the same operation."
Documented:
. called: "a group underlies a magma"
Id: "ff71ef02-ec19-4e54-8dc8-4dd4f54ecfa2"


-- A quoted `"#topic"` or `"\signature"` names a reference rather than a usage.
Relation:
between: "#algebra"
and: "\group"
means: "Groups are the subject matter of algebra."
Id: "960ef264-b87a-4366-a17a-0b5f4d41679b"


-- `Topic` names documentation subject matter.
[#algebra]
Topic: "The study of operations on sets."
Documented:
. called: "Algebra"
Id: "cd54e9f9-3233-4381-a49c-81151fb7f0fd"


[#group.theory]
Topic: "Algebra of invertible operations."
within: "#algebra"
Related:
. to: "#algebra"
  . "\group"
  means: "Group theory is the part of algebra about groups."
Documented:
. called: "Group Theory"
Id: "d38c98a5-6f04-49a0-8009-44bb6e34db82"


-- `Person` and `Resource` carry bibliography metadata.
[@emmy.noether]
Person: "Emmy Noether"
biography: "Worked on abstract algebra and invariant theory."
Id: "0051d110-103e-4fc1-80dc-719045462cab"


[@nicolas.bourbaki]
Person:
