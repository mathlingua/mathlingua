-- Every support section, shown one at a time.


-- `Documented:` carries all of an item's human-facing text and rendering.
[\documented.showcase]
Defines: X ::= x(i_)
Documented:
. called: "documented showcase"
. written: "\operatorname{showcase}"
. writing: x(i)
  as: "x?_{i?}"
. overview: "A one-line summary."
. description: "A longer description of the idea."
. related: "#algebra"
. discoverer: "@emmy.noether"
Id: "0b81f148-f5c4-411d-bbaa-6f5dd4566db6"


-- `Requires:` states what a *use* of the command must establish beforehand.
-- A `capability:` provides a spec operator; a `definition:` requires that a
-- named command exist with a given type.
[\requires.showcase]
Defines: X
Requires:
. capability: x_ "in" X :-> \\abstract
. definition: \zero is \natural
Documented:
. called: "requires showcase"
Id: "b4643f0c-2a8e-4b8c-9c45-daf810276e37"


-- `Enables:` states what knowing the type lets the checker do afterwards.
[\enables.showcase]
Defines: G ::= (X, *) is \set via X
means: * is \operation:on{G}
Enables:
. capability: x_ "in" G :-> x_ is \element:of{X}
  written: "x_? \in G?"
. from: Y ::= {y__ : ...}
  capability: x_ "in" G :-> x_ member_of Y
. relation:
  to: S := \unit.set
  when: G is \enables.showcase
  represents: \\coercion
Documented:
. called: "enables showcase"
Id: "80bdeb53-b07a-411c-b7e2-7bd81e2059cb"


-- `Justification:` holds labelled `have:` groups. A `[:label:]` on an item in
-- the body points at one, and the checker takes that item as given.
[\justification.showcase]
Defines: X ::= (A, B)
means:
. A is \set
. (.B is \set.)[:carrier:]
Documented:
. called: "justification showcase"
Justification:
. [carrier]
  have: B is \set
  asserting: B is \set
Id: "decbcbc2-aa62-430f-aa16-d044ea928c10"


-- `Aliases:` name an expression or a spec operator locally; `Writing:` gives
-- item-local rendering aliases; `References:` cites resources; `Metadata:`
-- records release bookkeeping.
[\alias.showcase]
Defines: G ::= (X, *) is \set via X
means: * is \operation:on{G}
Documented:
. called: "alias showcase"
Aliases:
. alias: twice(x_) :=> x_ * x_
  written: "x_?^{2}"
Writing:
. "carrier :~> \mathrm{carrier}"
References:
. $bourbaki.algebra
Metadata:
. id: "alias-showcase"
Id: "9b8fdb86-1a09-4859-83ac-dc03c3d46fd2"


-- The capability above reduces a membership spec fact to a type fact.
Theorem:
given:
. G ::= (X, *) is \enables.showcase
. y is \element:of{X}
where: y "in" G
then: y is? \element:of{X}
Documented:
. called: "a capability reduces membership"
Id: "6f2caf05-a403-49ae-9ffd-28530e77efec"
